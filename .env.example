# Baked into the client bundle at build time (process.env.NEXT_PUBLIC_*).
# For production behind ALB, set this to the public API origin.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public base URL of the avatars bucket (MinIO locally, S3 in production).
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/docs-lite-avatars
